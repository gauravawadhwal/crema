      "input": {"page": "littlecomet-las-nubes.txt"},
      "expect": {
        "roaster": "Little Comet",
        "name": "Las Nubes",
        "country": "Colombia",
        "region": "Tolima",
        "processKind": ["anaerobic", "experimental"],
        "processIncludes": ["anaerobic", "72"],
        "roastLevel": "light",
