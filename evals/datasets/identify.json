      "input": {"url": "https://quarrylane.example/shop/foundry-espresso-blend", "page": "quarry-foundry.txt"},
      "expect": {
        "roaster": "Quarry Lane",
        "name": "Foundry",
        "isBlend": true,
        "blendIncludes": ["Brazil", "Colombia", "Papua New Guinea"],
        "roastLevel": "medium-dark",
        "roastedFor": "espresso",
        "tastingNotes": ["dark chocolate", "hazelnut", "toffee"],
        "roasterRecipe": null,
        "roastDate": null
      }
    },
    {
