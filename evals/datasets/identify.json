{
  "description": "Coffee identification (BeanInfo) from bag photos, an already-fetched product page and/or a search query. Fixtures in evals/fixtures/ are fictional roasters (.example domains) built so each case has one unambiguous answer; 'live' cases look up real coffees on the web and run only with --live.",
  "cases": [
    {
      "id": "id-page-kenya",
      "split": "dev",
      "tags": ["page", "single-origin"],
      "why": "A complete roaster page. Every field is stated, including an espresso recipe, but there's no roast date because no website knows when this bag was roasted.",
      "input": {"url": "https://fernhollow.example/products/kirinyaga-kiamugumo-aa", "page": "fernhollow-kiamugumo.txt"},
      "expect": {
        "roaster": "Fernhollow",
        "name": "Kiamugumo",
        "country": "Kenya",
        "region": "Kirinyaga",
        "processKind": "washed",
        "roastLevel": "light",
        "roastedFor": "omni",
        "isBlend": false,
        "altitudeMasl": [1700, 1850],
        "varietyIncludes": ["SL28", "SL34"],
        "tastingNotes": ["blackcurrant", "grapefruit", "demerara"],
        "roasterRecipe": {"doseG": 19, "yieldG": 45, "tempC": 94},
        "roastDate": null,
        "needsConfirmation": ["roastDate"],
        "productUrl": "https://fernhollow.example/products/kirinyaga-kiamugumo-aa"
      }
    },
    {
      "id": "id-page-blend-milk",
      "split": "dev",
