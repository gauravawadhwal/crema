  "interventions": [],
  "grading": {
    "consequence": "The 4 mL/s Fill encounters its pressure ceiling. At about 10 s the programmed inlet command goes to zero for 30 s. Pressure decays, with at most residual drips while inlet settles. The 1.2 mL/s restart at 40 s follows the plan, then flow ramps and settles near 2.1 mL/s. The pause and pressure decay are descriptive landmarks.",
    "unknowableWhen": [
      "If the logged flow command and frame schedule are unavailable, the drop and restart alone cannot establish a planned pause.",
      "If scale samples are missing, stale, or discontinuous around a crossing, abstain on first sustained beverage timing and any cup-rate estimate spanning the gap.",
      "Hydraulics and cup mass alone do not establish channeling, sweetness, or extraction yield."
    ],
    "acceptCauseAbstention": true,
    "observations": [
      {"id": "pause-entry", "kind": "phase_boundary", "expected": "required", "phase": "preinfusion", "controlledVariable": "flow", "timing": {"type": "raw-landmark", "onsetS": [10, 10.35]}},
      {"id": "restart-entry", "kind": "phase_boundary", "expected": "required", "phase": "pouring", "controlledVariable": "flow", "timing": {"type": "raw-landmark", "onsetS": [40, 40.35]}},
      {"id": "first-gram", "kind": "first_sustained_beverage", "expected": "required", "phase": "pouring", "controlledVariable": "flow", "timing": {"type": "raw-landmark", "onsetS": [41.2, 42.6]}},
      {"id": "planned-ramp", "kind": "planned_rise", "expected": "required", "phase": "pouring", "controlledVariable": "flow", "timing": {"type": "raw-landmark", "onsetS": [47.3, 48.5]}},
      {"id": "pause-flow-fault", "kind": "flow_shortfall", "expected": "forbidden", "phase": "preinfusion", "controlledVariable": "flow"},
      {"id": "pressure-tracking-fault", "kind": "pressure_shortfall", "expected": "forbidden"},
      {"id": "channeling-diagnosis", "kind": "channeling", "expected": "forbidden"},
      {"id": "pour-flow-fault", "kind": "flow_shortfall", "expected": "forbidden", "phase": "pouring", "controlledVariable": "flow"}
    ],
    "supportedOutcomes": [
      "abstain"
    ],
    "forbiddenClaims": [
      "inferred-taste",
      "unqualified-diagnosis",
      "multiple-next-shot-changes"
    ]
  }
