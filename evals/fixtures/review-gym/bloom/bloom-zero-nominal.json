  "profile": {
    "temperatureC": 92,
    "steps": [
      {"name": "Fill", "pump": "flow", "target": 4, "seconds": 10, "substate": "preinfusion", "limiter": {"value": 3.5, "range": 0.3}},
      {"name": "Bloom pause", "pump": "flow", "target": 0, "seconds": 30, "substate": "preinfusion"},
      {"name": "Restart", "pump": "flow", "target": 1.2, "seconds": 14, "weightG": 8, "limiter": {"value": 9, "range": 0.5}},
      {"name": "Ramp", "pump": "flow", "target": 2.1, "seconds": 5, "transition": "smooth", "limiter": {"value": 9, "range": 0.5}},
      {"name": "Extract", "pump": "flow", "target": 2.1, "seconds": 40, "limiter": {"value": 9, "range": 0.5}}
