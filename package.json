{
  "name": "crema",
  "version": "0.1.0",
  "description": "A custom home screen and companion app for the Decent DE1 espresso machine: coffee identification, profile recommendations and day-to-day controls.",
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "start": "tsx server/main.ts",
    "mock:decaid": "tsx dev/mock-decaid.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "eval": "tsx evals/run.ts",
    "eval:compare": "tsx evals/compare.ts",
    "eval:labels": "node evals/fixtures/render-labels.cjs",
    "build:demo": "node scripts/build-demo.mjs",
    "e2e": "node scripts/e2e-demo.cjs",
    "e2e:built": "node scripts/e2e-demo.cjs --built",
    "check:tablet": "node scripts/check-tablet-fit.cjs",
    "build:site": "node scripts/build-site.mjs",
    "screenshots": "node scripts/screenshots.cjs",
    "record": "node scripts/record-walkthrough.cjs",
    "package:skin": "node scripts/package-skin.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "e2e:live": "node scripts/e2e-live.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "tsx": "^4.23.15",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
