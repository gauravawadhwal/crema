{
  "name": "crema",
  "version": "0.1.0",
  "description": "A custom DE1 companion: identify coffees from a photo, search or link, and get recipe recommendations.",
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "start": "tsx server/main.ts",
    "mock:decaid": "tsx dev/mock-decaid.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "build:demo": "node scripts/build-demo.mjs",
    "e2e": "node scripts/e2e-demo.cjs",
    "e2e:built": "node scripts/e2e-demo.cjs --built",
    "check:tablet": "node scripts/check-tablet-fit.cjs",
    "build:site": "node scripts/build-site.mjs",
    "screenshots": "node scripts/screenshots.cjs",
    "record": "node scripts/record-walkthrough.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
