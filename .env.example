# Crema server settings. Copy to .env and fill in. Never commit .env.
# See docs/install.md for every option.

# AI providers, tried in order: claude-cli, codex-cli, anthropic-api, gemini-api, mock
LLM_PROVIDERS=claude-cli

# claude-cli: run `claude setup-token` on any computer and paste the token here
CLAUDE_CODE_OAUTH_TOKEN=

# anthropic-api / gemini-api: API keys, if you use those providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# A Gemini key also switches on speaking in "Describe it", whatever LLM_PROVIDERS says

# Optional: Decaid on the DE1 tablet, to open the app from this server
# (http://<server>:8787) as well as from the tablet. Use an address phones can reach.
DECAID_URL=

# Docker only: which AI CLIs to build into the image
AI_CLIS=@anthropic-ai/claude-code
