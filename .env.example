# Copy to .env and fill in. Never commit .env.

# Decaid on the DE1 tablet (give the tablet a fixed IP in your router)
DECAID_URL=http://192.168.1.50:8080

# AI providers, tried in order: claude-cli, codex-cli, anthropic-api, gemini-api, mock
LLM_PROVIDERS=claude-cli

# claude-cli: run `claude setup-token` on any computer and paste the token here
CLAUDE_CODE_OAUTH_TOKEN=

# anthropic-api / gemini-api: API keys, if you use those providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Docker only: which AI CLIs to build into the image
AI_CLIS=@anthropic-ai/claude-code
